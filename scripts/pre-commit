#!/bin/sh
#
# Pre-commit hook: security- en stylechecks voor ZAP Foundation.
# Geïnstalleerd door scripts/install-hooks.js via `npm install`.
#
# Te omzeilen met `git commit --no-verify` — dit is een vangrail, geen garantie.
#

RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m'

errors=0

# Alleen staged bestanden checken (niet de verwijderde)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=d)

if [ -z "$STAGED_FILES" ]; then
    exit 0
fi

# ---------------------------------------------------------------------------
# 1. $env/static/private import in client-side bestanden
#    Veilig: +server.js, *.server.js, src/lib/server/
#    Onveilig: +page.js, +page.svelte, +layout.svelte, overig src/lib/
# ---------------------------------------------------------------------------
CLIENT_FILES=$(echo "$STAGED_FILES" | grep -E '\.(js|ts|svelte)$' \
    | grep -v '\.server\.' \
    | grep -v '+server\.' \
    | grep -v 'src/lib/server/' \
    | grep -v '^scripts/' \
    | grep -v 'node_modules')

if [ -n "$CLIENT_FILES" ]; then
    PRIVATE_HITS=$(echo "$CLIENT_FILES" | xargs grep -ln '\$env/static/private' 2>/dev/null || true)
    if [ -n "$PRIVATE_HITS" ]; then
        echo "${RED}GEBLOKKEERD: \$env/static/private import in client-side code!${NC}"
        echo "$PRIVATE_HITS" | while read -r f; do echo "  - $f"; done
        echo ""
        echo "Private env-variabelen mogen ALLEEN in server-side bestanden gebruikt worden."
        errors=$((errors + 1))
    fi
fi

# ---------------------------------------------------------------------------
# 2. Hardcoded secrets / API keys
# ---------------------------------------------------------------------------
CODE_FILES=$(echo "$STAGED_FILES" | grep -E '\.(js|ts|svelte|json|yml|yaml|jsonc)$' \
    | grep -v 'node_modules' \
    | grep -v 'package-lock.json')

if [ -n "$CODE_FILES" ]; then
    SECRET_HITS=$(echo "$CODE_FILES" \
        | xargs grep -lniE '(token|secret|password|apikey|api_key)[[:space:]]*[:=][[:space:]]*["'"'"'][A-Za-z0-9_\-]{20,}' 2>/dev/null || true)
    if [ -n "$SECRET_HITS" ]; then
        echo "${RED}GEBLOKKEERD: mogelijk hardcoded secret gevonden!${NC}"
        echo "$SECRET_HITS" | while read -r f; do echo "  - $f"; done
        echo ""
        echo "Gebruik .env (gitignored) of Cloudflare secrets. Vals alarm? Commit met --no-verify."
        errors=$((errors + 1))
    fi
fi

# ---------------------------------------------------------------------------
# 3. .env / .dev.vars bestanden stagen
# ---------------------------------------------------------------------------
ENV_HITS=$(echo "$STAGED_FILES" | grep -E '(^|/)\.(env|dev\.vars)' | grep -v '\.example$' || true)
if [ -n "$ENV_HITS" ]; then
    echo "${RED}GEBLOKKEERD: env-bestand staged!${NC}"
    echo "$ENV_HITS" | while read -r f; do echo "  - $f"; done
    echo ""
    echo "Alleen *.example varianten horen in git."
    errors=$((errors + 1))
fi

# ---------------------------------------------------------------------------
# 4. Stylelint op staged CSS/Svelte
#    Volledig-staged bestanden worden auto-fixed en opnieuw ge-add.
#    Deels-staged bestanden worden alleen gecontroleerd — anders zou `git add`
#    ongestaged werk mee de commit in trekken.
# ---------------------------------------------------------------------------
STYLE_FILES=$(echo "$STAGED_FILES" | grep -E '\.(css|svelte)$' | grep -v 'node_modules' || true)

if [ -n "$STYLE_FILES" ]; then
    echo "$STYLE_FILES" | while read -r f; do
        [ -f "$f" ] || continue
        if git diff --name-only -- "$f" | grep -q .; then
            # Deels staged: alleen checken
            npx stylelint "$f" || exit 1
        else
            # Volledig staged: fixen en opnieuw stagen
            npx stylelint --fix "$f" || exit 1
            git add "$f"
        fi
    done || errors=$((errors + 1))
fi

if [ "$errors" -gt 0 ]; then
    printf "\n${YELLOW}Commit geblokkeerd. Fix bovenstaande punten.${NC}\n" >&2
    exit 1
fi

exit 0
